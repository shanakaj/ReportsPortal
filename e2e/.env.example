# ============================================
# E2E Test Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
#
# Setup steps:
#   1. Deploy the stack (npx cdk deploy --all --context environment=dev)
#   2. Copy this file to .env
#   3. Fill in CloudFront domain, passwords, and Cognito details
#   4. Run: ./scripts/provision-test-users.sh (creates admin + customer in Cognito)
#   5. Run: npx playwright test (global-setup handles MFA + test data)
#
# TOTP secrets are auto-generated during MFA_SETUP and saved to .auth-state.json.
# You do NOT need to set them manually unless reusing across machines.
# ============================================

# Base URL — your CloudFront distribution domain
BASE_URL=https://d1xxxxxxx.cloudfront.net

# API Gateway URL — typically CloudFront /api path
API_BASE_URL=https://d1xxxxxxx.cloudfront.net/api

# Cognito User Pool
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
AWS_REGION=ap-southeast-2

# ---- Super Admin ----
# The initial super_admin user (seeded during first deployment)
SUPER_ADMIN_EMAIL=superadmin@versent.com.au
SUPER_ADMIN_PASSWORD=YourSuperAdminPassword!

# TOTP secret (base32) — auto-saved to .auth-state.json after first MFA_SETUP.
# Only set this if you already have a known TOTP secret for this user.
# SUPER_ADMIN_TOTP_SECRET=

# ---- Test Admin (role: admin) ----
# Created by ./scripts/provision-test-users.sh
TEST_ADMIN_EMAIL=testpr.admin@versent.com.au
TEST_ADMIN_PASSWORD=TestAdmin@2026!

# Auto-saved to .auth-state.json after first MFA_SETUP
# TEST_ADMIN_TOTP_SECRET=

# ---- Test Customer (role: customer) ----
# Created by ./scripts/provision-test-users.sh
TEST_CUSTOMER_EMAIL=testpr.customer@example.com.au
TEST_CUSTOMER_PASSWORD=TestCustomer@2026!

# Auto-saved to .auth-state.json after first MFA_SETUP
# TEST_CUSTOMER_TOTP_SECRET=
